{
  "name": "Meter",
  "description": "Colour and type tokens for VERB. Light values are canonical; dark values are the paired inversions.",
  "version": "0.1.0",
  "colour": {
    "neutral": {
      "ink":    { "light": "#101418", "dark": "#F6F5F2" },
      "slate":  { "light": "#2A333B", "dark": "#D3D0C9" },
      "steel":  { "light": "#4A555F", "dark": "#9AA3AB" },
      "mist":   { "light": "#6B7780", "dark": "#7E888F" },
      "line":   { "light": "#DCD8CF", "dark": "#2B3238" },
      "shell":  { "light": "#EDEBE5", "dark": "#171C21" },
      "paper":  { "light": "#F6F5F2", "dark": "#101418" }
    },
    "brand": {
      "primary": { "light": "#1F3A34", "dark": "#7FD8C2" },
      "bright":  { "light": "#2E7D6B", "dark": "#5FBFA6" }
    },
    "decision_class": {
      "A": { "light": "#2E7D6B", "dark": "#5FBFA6", "meaning": "machine-checkable" },
      "B": { "light": "#3C6E9F", "dark": "#7FB0DE", "meaning": "sample-checkable" },
      "C": { "light": "#B8843A", "dark": "#E0AE63", "meaning": "expert-checkable" },
      "D": { "light": "#A34432", "dark": "#E4785C", "meaning": "not checkable in advance" }
    },
    "status": {
      "in_budget": { "light": "#1F7A5C", "dark": "#5FBFA6" },
      "at_limit":  { "light": "#B8843A", "dark": "#E0AE63" },
      "overdraft": { "light": "#A34432", "dark": "#E4785C" }
    }
  },
  "type": {
    "sans": "system-ui, -apple-system, \"Segoe UI\", Roboto, Helvetica, Arial, sans-serif",
    "mono": "ui-monospace, SFMono-Regular, Menlo, Consolas, \"Liberation Mono\", monospace",
    "rule": "Every number is set in mono. Every sentence is set in sans."
  },
  "geometry": {
    "unit": "4px",
    "radius": "6px",
    "radius_large": "12px"
  }
}
